# ============================================================================
# 开发环境配置模板（dev 模式）
# ============================================================================
# 用法:  cp backend/.env.dev.example backend/.env.dev
#
# 运行模式由 **APP_MODE=dev** 决定（见 app/core/config/profiles.py）：
#   dev  → 库名必须以 _dev 结尾；日志 DEBUG + 详细格式；/docs 开启
#
# ⚠️ 为什么 dev 的库名必须带 _dev 后缀：
#   2026-09-10 与 2026-09-22 两次同因事故的根因是**库名无区分**——
#   本地与生产都叫 csctalon，连错库时配置/日志/界面没有任何信号。
#   现在启动期会校验「模式 ↔ 库名」，连错库**直接拒绝启动**（见 guard.py）。
# ============================================================================

# 运行模式（唯一入口；兼容旧变量 ENV）
# ⚠️ 容器部署时由 docker-compose 显式注入 ENV=prod；本地开发用 APP_MODE=dev
APP_MODE=dev

# 数据库（库名以 _dev 结尾是启动期的硬要求）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=csctalon
POSTGRES_PASSWORD=csctalon123
POSTGRES_DB=csctalon_dev

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 安全（dev 环境允许弱值；prod 会 fail-fast 拒绝）
JWT_SECRET_KEY=dev-only-not-for-production-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# 上传与目录（相对 backend/；dev 默认 ./uploads）
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200

# 跨域（本地前端）
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

# 排障开关：需要看 SQL 时开（默认关，避免日志噪音）
SQL_ECHO=false
# 本地调试可关掉定时同步，避免干扰
BMS_SCHEDULE_AUTOSTART=false
