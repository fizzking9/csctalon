# 客服中心管理系统 - 环境配置模板
# 复制为 .env 后按实际环境填写,切勿将真实 .env 提交到 git

ENV=dev
DEBUG=true

# ---------- 站点备案信息(登录页/全局页脚展示, 网站备案要求) ----------
# ICP 备案号, 如: 京ICP备12345678号-1
ICP_BEIAN_NO=
# 公安备案号, 如: 京公网安备 11010502000000号
PSB_BEIAN_NO=
# 备案备注/网站性质说明, 如: 个人开发数据分析系统应用测试，内部数据和流程测试
BEIAN_NOTE=
# 版权主体(个人网站填个人昵称/姓名)
COPYRIGHT_HOLDER=tanzk
# 网站副标题
SITE_SUBTITLE=专注数据分析与内部工具

# ---------- 数据库 ----------
POSTGRES_USER=csctalon
POSTGRES_PASSWORD=<请修改为强密码>
POSTGRES_DB=csctalon
# Docker Compose 部署时填 db;本机直连时填 127.0.0.1
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 生产必填(fail-fast 校验: ENV=prod 时为空即拒绝启动); dev 可留空仅本机连
REDIS_PASSWORD=<请修改为强密码>

# ---------- JWT ----------
# 生产环境务必改为随机长字符串(建议 32+ 位)
JWT_SECRET_KEY=<请修改为随机长字符串>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
# Playwright 登录态保存目录(独立于 UPLOAD_DIR,不被静态文件挂载暴露)
BROWSER_STATE_DIR=./data/browser_states

# ---------- 跨域 ----------
# 局域网部署,前端与后端同域时可不配;分离部署时填前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

# ---------- 初始管理员 ----------
INIT_ADMIN_USERNAME=admin
# 首次启动后请立即修改默认密码
INIT_ADMIN_PASSWORD=<请修改默认密码>

# ---------- SCRM 白音平台凭证(仅 fix 脚本灌入用,运行时从 DB 读) ----------
# ⚠️ 严禁硬编码进脚本/入库;此处留空,通过环境变量或 .env 注入真实值
# OpenAPI 网关凭证
SCRM_CLIENT_ID=
SCRM_CLIENT_SECRET=
# Playwright 网页登录凭证(手机号/密码)
SCRM_WEB_USERNAME=
SCRM_WEB_PASSWORD=

# ---------- workbuddy 投诉数据推送鉴权(315投诉/卡商投诉同步) ----------
# 生产必填强随机串(openssl rand -hex 32),为空时同步接口返回 503。
# workbuddy 推送时携带请求头: Authorization: Bearer <该值>
WORKBUDDY_SYNC_TOKEN=<请修改为随机长字符串>
