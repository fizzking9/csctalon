# 客服中心管理系统 - 环境配置模板
# 复制为 .env 后按实际环境填写,切勿将真实 .env 提交到 git

ENV=dev
DEBUG=true

# ---------- 数据库 ----------
POSTGRES_USER=csctalon
POSTGRES_PASSWORD=<请修改为强密码>
POSTGRES_DB=csctalon
# Docker Compose 部署时填 db;本机直连时填 127.0.0.1
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- JWT ----------
# 生产环境务必改为随机长字符串(建议 32+ 位)
JWT_SECRET_KEY=<请修改为随机长字符串>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200

# ---------- 跨域 ----------
# 局域网部署,前端与后端同域时可不配;分离部署时填前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

# ---------- 初始管理员 ----------
INIT_ADMIN_USERNAME=admin
# 首次启动后请立即修改默认密码
INIT_ADMIN_PASSWORD=<请修改默认密码>
