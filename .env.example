# 客服中心管理系统 - 部署环境配置模板
# 复制为 .env 后按实际环境填写，切勿将真实 .env 提交到 git。
# docker-compose.yml 自动加载同目录 .env：db 用 ${} 插值，backend 经 env_file 注入。

# ---------- 运行模式 ----------
ENV=prod
DEBUG=false
SQL_ECHO=false

# ---------- 数据库 ----------
POSTGRES_USER=csctalon
POSTGRES_PASSWORD=<请修改为强密码>
POSTGRES_DB=csctalon
# Docker Compose 部署时填 db；本机直连时填 127.0.0.1
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 生产必填(fail-fast: ENV=prod 时为空即拒绝启动); redis 容器据此设 requirepass
REDIS_PASSWORD=<请修改为强密码>

# ---------- JWT ----------
# 生产环境务必改为随机长字符串（建议 32+ 位）。注意：更换后已签发 token 失效、
# 且 CONFIG_ENCRYPTION_KEY 留空时同步源加密凭证由本 key 派生，更换会致旧凭证无法解密。
# ⚠️ 2026-08-20 审计 H-4：ENV=prod 时 fail-fast 会拒绝占位短语(含 please/change/random/请修改 等词)
#    与长度 <32 的 JWT_SECRET_KEY。轮换顺序(先凭证后 JWT，防同步凭证失联)：
#     1) 生成新 CONFIG_ENCRYPTION_KEY（openssl rand -base64 32）
#     2) 用新 key 重加密 sync_source_configs 存量凭证（重跑 fix 脚本或管理界面重填）
#     3) 再更换 JWT_SECRET_KEY 并重启
JWT_SECRET_KEY=<请修改为随机长字符串>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 敏感配置加密 key（同步源凭证加密用）；留空则从 JWT_SECRET_KEY 派生
# 生产建议显式设置独立随机 key（先于 JWT 轮换生效），避免 JWT 轮换连带凭证失联
CONFIG_ENCRYPTION_KEY=

# ---------- 上传 ----------
# 本地开发默认值 = 容器内相对路径(配合 compose 默认挂载 ./uploads:/app/uploads)。
# ⚠️ docker-compose.yml backend environment 已显式注入容器内路径
#    UPLOAD_DIR=/app/uploads / BROWSER_STATE_DIR=/app/data/browser_states(覆盖 env_file 值),
#    故 .env 里的 UPLOAD_DIR 仅作 **compose 宿主机挂载源**(生产在 env.production.example 设
#    /opt/csctalon/uploads 等宿主绝对路径), 不再是容器内读写路径(2026-09-06 修复路径错位)。
# ⚠️ 统一用单数 UPLOAD_DIR/BROWSER_STATE_DIR(与后端代码 settings 同名),
# 勿再用复数 UPLOADS_DIR/BROWSER_STATES_DIR(2026-08-30 已废弃, 配错会导致路径错配)。
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
# Playwright 登录态保存目录(独立于 UPLOAD_DIR,不被静态文件挂载暴露)
BROWSER_STATE_DIR=./data/browser_states

# ---------- 跨域（局域网部署） ----------
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ---------- 初始管理员（仅首次启动建账用；已建账后改此值不生效） ----------
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=<请修改默认密码>

# ---------- BMS 平台同步凭证 ----------
BMS_USERNAME=
BMS_PASSWORD=

# ---------- 定时同步 ----------
# 默认开启:否则跨日/重启后整小时同步窗口全部漏执行
BMS_SCHEDULE_AUTOSTART=true

# ---------- SCRM 白音平台凭证(仅 fix 脚本灌入用,运行时从 DB 读) ----------
# ⚠️ 严禁硬编码进脚本/入库;此处留空,通过环境变量或 .env 注入真实值
# OpenAPI 网关凭证
SCRM_CLIENT_ID=
SCRM_CLIENT_SECRET=
# Playwright 网页登录凭证(手机号/密码)
SCRM_WEB_USERNAME=
SCRM_WEB_PASSWORD=

# ---------- 微信扫码登录(2026-08-20 审计 H-1) ----------
# 生产必须配置真实 WECHAT_APPID/WECHAT_SECRET(微信开放平台/小程序),否则扫码登录/注册返回 503
# WECHAT_APPID=
# WECHAT_SECRET=
# 开发调试才允许 mock openid(且需 ENV=dev/test): 显式设为 true
WECHAT_MOCK_ALLOWED=false

# ---------- workbuddy 投诉数据推送鉴权(315投诉/卡商投诉同步) ----------
# 生产必填强随机串(openssl rand -hex 32),为空时同步接口返回 503。
# workbuddy 推送时携带请求头: Authorization: Bearer <该值>
WORKBUDDY_SYNC_TOKEN=<请修改为随机长字符串>
