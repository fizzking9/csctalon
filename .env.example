# 客服中心管理系统 - 部署环境配置模板
# 复制为 .env 后按实际环境填写，切勿将真实 .env 提交到 git。
# docker-compose.yml 自动加载同目录 .env：db 用 ${} 插值，backend 经 env_file 注入。

# ---------- 运行模式 ----------
ENV=prod
DEBUG=false
SQL_ECHO=false

# ---------- 数据库 ----------
POSTGRES_USER=csctalon
POSTGRES_PASSWORD=<请修改为强密码>
POSTGRES_DB=csctalon
# Docker Compose 部署时填 db；本机直连时填 127.0.0.1
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- JWT ----------
# 生产环境务必改为随机长字符串（建议 32+ 位）。注意：更换后已签发 token 失效、
# 且 CONFIG_ENCRYPTION_KEY 留空时同步源加密凭证由本 key 派生，更换会致旧凭证无法解密。
JWT_SECRET_KEY=<请修改为随机长字符串>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 敏感配置加密 key（同步源凭证加密用）；留空则从 JWT_SECRET_KEY 派生
CONFIG_ENCRYPTION_KEY=

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200

# ---------- 跨域（局域网部署） ----------
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ---------- 初始管理员（仅首次启动建账用；已建账后改此值不生效） ----------
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=<请修改默认密码>

# ---------- BMS 平台同步凭证 ----------
BMS_USERNAME=
BMS_PASSWORD=

# ---------- 定时同步 ----------
BMS_SCHEDULE_AUTOSTART=false
