# 客服中心管理系统 - 阿里云生产环境变量模板
# 用法: 复制为 /opt/csctalon/.env 后编辑, 勿提交到 git。
#
# ⚠️⚠️ 从本地迁移时的密钥处理(与"免重新同步"直接相关) ⚠️⚠️
#   本地库里 sync_source_configs 的同步源凭证是用 CONFIG_ENCRYPTION_KEY 加密的
#   (该 key 留空时由 JWT_SECRET_KEY 派生)。要让阿里云上不用重新录入同步凭证:
#     → JWT_SECRET_KEY 与 CONFIG_ENCRYPTION_KEY **直接沿用本地 backend/.env 的值**,
#       不要轮换! 否则旧同步源密码无法解密, 只能重新录入(即需要"再次同步配置")。
#   ⚠️ 这样做等同于把本地密钥带到生产, 属降级; 建议后续一次性轮换:
#     1) 生成新 CONFIG_ENCRYPTION_KEY → 2) 在管理界面重填同步源凭证(用新 key 加密)
#     → 3) 再换 JWT_SECRET_KEY。详见 docs/腾讯云部署迁移方案.md §5.2。

# ---------- 运行模式 ----------
ENV=prod
DEBUG=false
SQL_ECHO=false

# 前端构建模式(仅 web 容器构建时生效):
#   release → 生产发布版, 只显示核心菜单(运营看板/工作台/我的待办/专项分析3项/系统管理), 其余菜单 debug-only
#   debug   → 内测版, 显示全部菜单
# 留空/不设置默认 release; 需要内测全量菜单时改为 debug 后 docker compose up -d --build
WEB_BUILD_MODE=release

# ---------- 站点备案信息(登录页/全局页脚展示, 网站备案要求) ----------
# ICP 备案号, 如: 京ICP备12345678号-1
ICP_BEIAN_NO=
# 公安备案号, 如: 京公网安备 11010502000000号
PSB_BEIAN_NO=
# 备案备注/网站性质说明, 如: 个人开发数据分析系统应用测试，内部数据和流程测试
BEIAN_NOTE=
# 版权主体(个人网站填个人昵称/姓名)
COPYRIGHT_HOLDER=tanzk
# 网站副标题
SITE_SUBTITLE=专注数据分析与内部工具

# ---------- 数据库 ----------
POSTGRES_USER=csctalon
POSTGRES_PASSWORD=<改为强密码, 首次部署可自由设定>
POSTGRES_DB=csctalon
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<改为强密码>

# ---------- JWT ----------
# 迁移时: 沿用本地 .env 的 JWT_SECRET_KEY(保证同步凭证可解密)
# 全新部署: openssl rand -hex 32 生成, 长度>=32
JWT_SECRET_KEY=<沿用本地值 或 新随机32+位>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 敏感配置加密 key; 迁移时沿用本地值(留空则由 JWT_SECRET_KEY 派生)
CONFIG_ENCRYPTION_KEY=<沿用本地值 或 留空>

# ---------- 上传 ----------
# 后端进程内读写路径(相对容器工作目录 /app, 由下方 UPLOAD_DIR 挂载变量映射到宿主机固定目录)
# ⚠️ 历史遗留: 单数 UPLOAD_DIR/BROWSER_STATE_DIR 与复数 UPLOADS_DIR/BROWSER_STATES_DIR 曾并存,
#    生产曾配 UPLOAD_DIR=./uploads(相对容器内、未挂载 → 失效残留), 实际生效的是复数挂载变量。
#    2026-08-30 已统一为单数(与后端代码 settings.UPLOAD_DIR/BROWSER_STATE_DIR 同名)。
MAX_UPLOAD_SIZE_MB=200

# 数据/日志/附件 固定目录(生产必须, 代码随版本切换, 数据不随代码动) ----------
# 服务器安装脚本 install-server.sh 会创建这些目录; 值与 docker-compose.yml 变量对应
DB_DATA_DIR=/opt/csctalon/data/postgres
REDIS_DATA_DIR=/opt/csctalon/data/redis
UPLOAD_DIR=/opt/csctalon/uploads
BROWSER_STATE_DIR=/opt/csctalon/browser_states
BACKEND_LOGS_DIR=/opt/csctalon/logs/backend
NGINX_LOGS_DIR=/opt/csctalon/logs/nginx
# backend 容器 env_file 指向(本 .env 自身路径; 供 compose 在代码目录外找到它)
ENV_FILE=/opt/csctalon/.env

# ---------- 跨域 ----------
# 内网部署: 填内网访问地址; 若启用 frp 外网访问(见 deploy/frp/README.md), 追加 https://<域名>,
# 多个用英文逗号分隔, 例如: http://192.168.1.10,https://kf.example.com
CORS_ORIGINS=http://<服务器内网IP或域名>,https://<frp域名>

# ---------- 初始管理员(仅首次启动建账用) ----------
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=<改为强密码, 建账后系统内改密>

# ---------- BMS 平台同步凭证 ----------
BMS_USERNAME=
BMS_PASSWORD=

# ---------- 定时同步 ----------
BMS_SCHEDULE_AUTOSTART=true

# ---------- SCRM 白音平台凭证(仅 fix 脚本灌入用, 运行时从 DB 读) ----------
SCRM_CLIENT_ID=
SCRM_CLIENT_SECRET=
SCRM_WEB_USERNAME=
SCRM_WEB_PASSWORD=

# ---------- 微信扫码登录 ----------
WECHAT_MOCK_ALLOWED=false
# WECHAT_APPID=
# WECHAT_SECRET=

# ---------- workbuddy 投诉数据推送鉴权 ----------
WORKBUDDY_SYNC_TOKEN=<openssl rand -hex 32 生成>

# ---------- 外部只读开放平台(/api/v1/external, 见 docs/arch/A-20260902-021) ----------
# 是否启用对外只读接口(token+scope 拉取经营数据/简报)。默认 false(关闭), 需显式开启。
EXTERNAL_API_ENABLED=false
# 全局默认限频(次/分钟): token 未配置 rate_limit_per_min 时使用。
EXTERNAL_RATE_LIMIT_DEFAULT_PER_MIN=60

