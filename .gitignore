# ============================================================
# 客服中心管理系统 - .gitignore
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ---------- Docker 本地覆盖 ----------
# docker-compose.override.yml 仅用于本地 macOS colima(改用 named volume 解决权限),
# 生产服务器不需要也不应加载; 误提交后已移除跟踪, 此处忽略防止再次提交。
docker-compose.override.yml

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
wheels/
*.manifest
*.spec

# 虚拟环境
.venv/
.venv_test/
venv/
env/
ENV/

# 测试 / lint 缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ---------- Node ----------
node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store/

# ---------- 环境配置(含密钥,不入库) ----------
.env
.env.local
.env.*.local
backend/.env
# 保留模板文件
!.env.example
!backend/.env.example
!web/.env.example

# ---------- 运行时数据 ----------
# 上传的业务文件(运行时挂载,仅保留目录占位)
backend/uploads/*
!backend/uploads/.gitkeep

# 样本数据(真实业务数据,含退费单号/商户信息等敏感内容,不入库)
01样本数据/

# ---------- Docker 运行时卷 ----------
pgdata/
redis-data/
backend-data/
# 部署数据/日志 bind mount 到宿主机（PG、Redis 持久化数据 + 应用日志）
# 注意：必须用 /data/（绝对路径），否则会错误忽略 web/src/views/data/ 下的所有源文件
/data/


# ---------- 日志 ----------
*.log
logs/
backend/logs/

# ---------- 部署产物(本地打包/备份,勿入库) ----------
backups/
